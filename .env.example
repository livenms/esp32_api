PORT=3000

# Session cookie signing secret - set a long random string in production.
SESSION_SECRET=change-this-to-a-long-random-string

# Optional: control the default admin account created on first boot.
# If not set, a default admin/Afriinnox@2026 account is created and its
# password is printed once to the server logs.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

NODE_ENV=production
